/**
 * @see https://www.electron.build/configuration/configuration
 */
{
  "appId": "com.qingshu.editor",
  "productName": "Qingshu",
  "copyright": "Copyright © 2026 Qingshu contributors",
  "asar": true,
  "directories": {
    "output": "release/${version}"
  },
  "files": [
    "dist-electron",
    "dist"
  ],
  "mac": {
    "icon": "build/icon.png",
    "category": "public.app-category.productivity",
    "artifactName": "${productName}_${version}.${ext}",
    "target": [
      "dmg"
    ]
  },
  "win": {
    "icon": "build/icon.ico",
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "artifactName": "${productName}_${version}.${ext}"
  },
  "linux": {
    "icon": "build/icon.png",
    "category": "Office",
    "synopsis": "A lightweight desktop Markdown editor",
    "description": "Qingshu is a lightweight desktop Markdown editor focused on clean writing, live preview, and practical CJK input.",
    "target": [
      "AppImage"
    ],
    "desktop": {
      "entry": {
        "Name": "Qingshu",
        "Comment": "Write and preview Markdown",
        "Categories": "Office;"
      }
    }
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false
  }
}
